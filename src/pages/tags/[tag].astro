---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Card from "../../components/Card.astro"

export function getStaticPaths(){
	const posts = Object.values(import.meta.glob('../blog/posts/*.md', {eager: true}))
	const uniqueTags = [...new Set(posts.map((post:any) =>post.frontmatter.tags).flat())]
    
	return uniqueTags.map((tag:any) => {
        const filterPosts = posts.filter((post:any)=>post.frontmatter.tags.includes(tag))
        return {
            params: {
                tag: tag
            },
            props: {
                posts: filterPosts
            }
        }
    })
}



