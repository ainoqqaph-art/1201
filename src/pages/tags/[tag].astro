    //}

const {tag} = Astro.params
const {posts} = Astro.props
---
<BaseLayout>
    <div class="text-center text-4xl font-bold mb-6">標籤為<span class="text-red-400">{tag}</span>的文章</div>
    <section class="'grid frid-cols-3 gap-8 mb-12">
        {
            posts.map((post:any) => <Card post={post.frontmatter} url={post.url}/>)
        }
    </section>
</BaseLayout>    