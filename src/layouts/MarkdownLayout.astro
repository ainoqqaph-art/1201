---
import BaseLayout from "./BaseLayout.astro"
import Tag from '../components/Tag.astro'
const {frontmatter} = Astro.props
---
<BaseLayout>
    <h2 class="text-3xl font-bold text-center mb-2">{frontmatter.title}</h2>
     <div class="text-center text-sm text-slate-400 mb-8">   
        <div>{frontmatter.pubDate.slice(0,10)}</div>
        <div>{frontmatter.author}</div>
    </div>
    <div class="flex gap-2 justify-center mb-6">
        {
            frontmatter.tags.map((tag:any) => <Tag tag={tag} />)
        }

    </div>
    
    
    <div class="text-slate-500 leading-7 [&>p]:mb-6 [&>ul]:mb-8 [&>ul]:list-disc [&>ul]:list-inside">
        <slot />
    </div>
    <a href="/blog">文章蝦米的</a>
</BaseLayout>
<style is:global>
    h1 {
        color:brown
    }
</style>